# ==============================================================================
# JARVIS Background Agent Configuration
# ==============================================================================
# Each agent runs on its own cron schedule (standard 5-field cron syntax).
# Set enabled: false to disable without removing the entry.
# Edit params to customise what each agent does for you.
# ==============================================================================

agents:

  # ---------------------------------------------------------------------------
  # Newsletter Digest
  # Searches the web for news on your chosen topics and produces a daily brief.
  # ---------------------------------------------------------------------------
  - name: newsletter
    display_name: "Daily Newsletter"
    description: >
      Searches the web for news on configured topics and produces a concise
      daily digest. Delivered every morning at 8 AM.
    enabled: true
    schedule: "0 8 * * *"    # 8:00 AM daily (server local time)
    params:
      topics:
        - "artificial intelligence news"
        - "tech industry news"
        - "software engineering"
        - "open source projects"
      max_articles: 12

  # ---------------------------------------------------------------------------
  # Job Monitor
  # Searches job boards for new listings matching your criteria.
  # Deduplicates against previously seen listings (7-day memory).
  # ---------------------------------------------------------------------------
  - name: job_monitor
    display_name: "Job Monitor"
    description: >
      Monitors job boards (LinkedIn, Greenhouse, Lever, Indeed) for new listings
      matching your keywords and location. Runs every 6 hours.
    enabled: true
    schedule: "0 */6 * * *"  # Every 6 hours
    params:
      keywords:
        - "software engineer"
        - "AI engineer"
        - "machine learning engineer"
        - "backend engineer"
      location: "remote"

  # ---------------------------------------------------------------------------
  # Web Monitor
  # Watches any search query for new content. Good for tracking product
  # releases, competitors, research papers, news about specific companies, etc.
  # ---------------------------------------------------------------------------
  - name: web_monitor
    display_name: "Web Monitor"
    description: >
      Monitors configured search queries for newly published content.
      Enable and add queries below to start tracking topics.
    enabled: false
    schedule: "0 * * * *"   # Every hour
    params:
      queries: []
      # Examples:
      # queries:
      #   - "OpenAI GPT-5 release date"
      #   - "Apple WWDC 2026 announcements"
      #   - "Nvidia Blackwell GPU availability"

  # ---------------------------------------------------------------------------
  # Price Monitor
  # Watches product pages and reports price drops. Runs twice a day.
  # Add products as {name, url} pairs below.
  # ---------------------------------------------------------------------------
  - name: price_monitor
    display_name: "Price Monitor"
    description: >
      Tracks prices on configured product pages and flags drops.
    enabled: false
    schedule: "0 9,18 * * *"   # 9 AM and 6 PM daily
    params:
      products: []
      # Examples:
      # products:
      #   - name: "Standing desk"
      #     url: "https://www.example.com/standing-desk"

  # ---------------------------------------------------------------------------
  # Weekly Grocery Ordering Agent
  # Automatically adds your grocery list to Amazon Fresh every week.
  # Customize the grocery_list below with your regular items.
  # Runs every Monday at 8:00 AM CDT (1 PM UTC).
  # ---------------------------------------------------------------------------
  - name: grocery
    display_name: "Weekly Grocery Order"
    description: >
      Automatically orders your weekly grocery list on Amazon Fresh every Monday
      morning. Sends a summary notification when complete.
    enabled: true
    schedule: "0 13 * * 1"   # Every Monday at 8:00 AM CDT (13:00 UTC)
    params:
      store_url: "https://www.amazon.com/alm/storefront?almBrandId=QW1hem9uIEZyZXNo"
      notify_on_complete: true
      grocery_list:
        - "Justin's Honey Peanut Butter 16 oz"
        - "whole milk"
        - "eggs"
        - "bread"
        - "bananas"
        - "chicken breast"
        - "olive oil"
        - "greek yogurt"
        # Add or remove items as needed

  # ---------------------------------------------------------------------------
  # Research & Task agents (dispatch targets)
  # These have NO schedule — JARVIS dispatches them on demand via spawn_task
  # when you ask it to "go research X" or "figure out Y". Listed here only so
  # the dashboard can show them; they run when triggered, not on a clock.
  # ---------------------------------------------------------------------------
  - name: research
    display_name: "Research Agent"
    description: >
      Multi-angle web research synthesized into a sourced briefing.
      Dispatched on demand by JARVIS (spawn_task).
    enabled: false
    schedule: ""
    params: {}

  - name: task
    display_name: "Task Agent"
    description: >
      Handles arbitrary delegated goals, with web research when needed.
      Dispatched on demand by JARVIS (spawn_task).
    enabled: false
    schedule: ""
    params: {}
