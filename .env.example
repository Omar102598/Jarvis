# ==============================================================================
# JARVIS Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=gpt-4.1

# --- Home Assistant ---
HA_URL=http://192.168.1.100:8123
HA_TOKEN=your-long-lived-access-token-here

# --- Govee (direct cloud API, optional if using HA integration) ---
GOVEE_API_KEY=your-govee-api-key-here

# --- Web Search ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Ring (optional, if using ring-client-api directly) ---
RING_REFRESH_TOKEN=your-ring-refresh-token-here

# --- Infrastructure ---
MQTT_HOST=mosquitto
REDIS_HOST=redis

# --- Room Configuration ---
ROOM_NAME=office

# --- Vision ---
# JSON map of camera_id to RTSP URL
CAMERA_URLS={}
# Example: CAMERA_URLS={"front_door": "rtsp://192.168.1.50:554/stream", "backyard": "rtsp://192.168.1.51:554/stream"}
PROCESS_FPS=5
FACE_THRESHOLD=0.4

# --- Speaker Verification ---
VERIFY_THRESHOLD=0.25

# --- Wake Word ---
WAKE_THRESHOLD=0.5

# --- TTS ---
# Options: "piper" (fast, local) or "xtts" (quality, voice cloning)
TTS_ENGINE=piper
PIPER_MODEL=en_GB-alan-medium
