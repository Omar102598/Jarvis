# ==============================================================================
# JARVIS Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=gpt-4.1

# --- Home Assistant ---
HA_URL=http://192.168.1.100:8123
HA_TOKEN=your-long-lived-access-token-here

# --- Govee (direct cloud API, optional if using HA integration) ---
GOVEE_API_KEY=your-govee-api-key-here

# --- Web Search ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Ring (optional, if using ring-client-api directly) ---
RING_REFRESH_TOKEN=your-ring-refresh-token-here

# --- Infrastructure ---
MQTT_HOST=mosquitto
REDIS_HOST=redis

# --- Audio Cache (shared between STT and Speaker Verify) ---
AUDIO_DIR=/data/audio_cache

# --- Room Configuration ---
ROOM_NAME=office

# --- User Identity (namespaces memory and conversation history per user) ---
JARVIS_USER_ID=default

# --- Vision ---
# JSON map of camera_id to RTSP URL
CAMERA_URLS={}
# Example: CAMERA_URLS={"front_door": "rtsp://192.168.1.50:554/stream", "backyard": "rtsp://192.168.1.51:554/stream"}
PROCESS_FPS=5
FACE_THRESHOLD=0.4

# --- Speech-to-Text ---
# STT_DEVICE: auto (default — CUDA when available, else CPU), cuda, or cpu
STT_DEVICE=auto
# STT_MODEL: leave empty for the device default (turbo on GPU, small on CPU).
# Options: tiny, base, small, medium, turbo, large-v3
STT_MODEL=

# --- Speaker Verification ---
VERIFY_THRESHOLD=0.25
# VERIFY_MODE: off (skip), log (verify + log, never block — default),
#              enforce (reject unrecognized voices)
VERIFY_MODE=log

# --- Wake Word ---
WAKE_THRESHOLD=0.5

# --- Mobile Gateway (iPhone / Siri Shortcut) ---
# Port the gateway listens on (mapped from the Docker container)
MOBILE_GATEWAY_PORT=8080
# Secret key the Siri Shortcut sends in the X-API-Key header.
# Set to a long random string. Leave empty to disable auth (LAN-only setups).
MOBILE_API_KEY=change-me-to-a-long-random-secret
# How long (seconds) to wait for the LLM agent to respond
MOBILE_LLM_TIMEOUT=45


# Options: "piper" (fast, local) or "xtts" (quality, voice cloning)
TTS_ENGINE=piper
PIPER_MODEL=en_GB-alan-medium

# --- Phase 0: Background Agents + Dashboard ---
DASHBOARD_PORT=8888

# ==============================================================================
# Extended Tools (all optional — each tool degrades gracefully if unset)
# ==============================================================================

# --- Files & system tools ---
# JARVIS reads/writes scratch files under this dir and notes under NOTES_DIR.
JARVIS_WORKSPACE=/data/workspace
NOTES_DIR=/data/notes
# run_shell allowlist: comma-separated command names, or "*" for any (trusted
# machines only). Empty = use the built-in safe default set.
SHELL_ALLOWLIST=
# run_python executes code in a subprocess. Off by default; enable only on a
# machine you trust.
CODE_EXEC_ENABLED=false

# --- Email (send_email) — works with Gmail app passwords, Fastmail, etc. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DEFAULT_TO=

# --- SMS (send_sms) via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_TO=

# --- Spotify (spotify_control) — playback control needs Premium ---
SPOTIFY_CLIENT_ID=ceb0a6cf227b438ab670b3a2a42519fe
SPOTIFY_CLIENT_SECRET=f38d61f0eb924c9aa14ec42d51a2837d
SPOTIFY_REFRESH_TOKEN=

# --- GitHub (github_tool) ---
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
