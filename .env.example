# ==============================================================================
# JARVIS Environment Configuration
# ==============================================================================
# Copy to .env and fill in. NEVER commit .env.
#     cp .env.example .env
#
# ALMOST EVERYTHING IS OPTIONAL. Every integration degrades gracefully when its
# key is missing — the tool simply reports it isn't set up. Start with the
# MINIMUM block below, get Jarvis talking, then add integrations one at a time.
#
# Sections:
#   1. Minimum to boot          6. Cameras / vision / presence
#   2. Identity & locale        7. Web, search & MCP integrations
#   3. Models & cost            8. Comms (email / SMS / IMAP)
#   4. Surfaces (app, dash)     9. Finance & media
#   5. Voice pipeline          10. Files, shell & the developer agent
#                              11. Agent tuning + VPS split
# ==============================================================================


# ==============================================================================
# 1. MINIMUM TO BOOT — set these four and the stack runs
# ==============================================================================

# Your Anthropic API key — THIS is what pays for the LLM. Each deployment uses
# its own key and is billed to that account: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default model tier for cheap/simple turns. The brain escalates to
# sonnet/opus per query on its own; this is only the floor.
LLM_MODEL=claude-haiku-4-5

# Shared secret the iOS/Mac apps and Siri send as the X-API-Key header.
# Use a long random string: `openssl rand -hex 32`
# Empty = auth disabled (ONLY safe on a trusted LAN — never on a public VPS).
MOBILE_API_KEY=change-me-to-a-long-random-secret

# Your timezone — container clocks are UTC, agents do day math against this.
USER_TZ=America/Chicago


# ==============================================================================
# 2. IDENTITY & LOCALE
# ==============================================================================

# Namespaces per-user data (memory, conversation, tasks, people, trips).
# NOTE: one Jarvis stack = one person. Running two people on ONE instance is
# NOT supported yet — profile/health/grocery/approval keys are still global.
# Two users = two separate deployments (each with its own .env and Redis).
JARVIS_USER_ID=default

# The room this machine's mic/speaker belong to (wake word + TTS routing).
ROOM_NAME=office

# Rooms with real speakers, comma-separated — used for announcement routing.
PHYSICAL_ROOMS=office

# Default weather location, e.g. "Austin, TX". Empty = derived from the
# user profile / asked for in conversation.
WEATHER_LOCATION=

# --- Prebuilt images (GHCR) -------------------------------------------------
# Installs PULL these instead of compiling from source (~2 min vs ~30 min).
# Published by .github/workflows/build-images.yml. Override the owner only if
# you fork and publish your own images.
JARVIS_IMAGE_OWNER=omar102598
JARVIS_TAG=latest

# --- Infrastructure (defaults work inside Docker Compose; change only if you
#     run services outside the compose network) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
REDIS_HOST=redis
REDIS_PORT=6379
CHROMA_HOST=chroma
CHROMA_PORT=8000


# ==============================================================================
# 3. MODELS & COST
# ==============================================================================

# Optional OpenAI key — only needed if you point any tier at GPT models.
# Jarvis is Claude-first; leave empty for a pure-Anthropic setup.
OPENAI_API_KEY=

# Model used by the developer agent (Forge). Coding is the one place the
# powerful tier earns its cost.
DEV_LLM_MODEL=claude-opus-4-8

# Vision model for camera-event assessment (cheap tier — runs on every motion).
SENTRY_MODEL=claude-haiku-4-5

# Nightly journal summarizer. Leave empty to use the default API model, or set
# a local model name (with OPENAI_BASE_URL below) to journal on-device for $0.
CHRONICLE_LLM_MODEL=

# Daily spend ceiling in USD across brain + agents. One urgent notification
# fires when today's total crosses it. 0 disables the alert.
DAILY_LLM_BUDGET_USD=15

# --- Local model tier (optional, Month 3) ---
# Point at an OpenAI-compatible local server to route the "local" tier there.
OLLAMA_BASE_URL=
LOCAL_LLM_MODEL=llama3.1
# Generic OpenAI-compatible base URL (used by agent_runner's local path).
OPENAI_BASE_URL=


# ==============================================================================
# 4. SURFACES — mobile gateway, dashboard, push
# ==============================================================================

MOBILE_GATEWAY_PORT=8080
MOBILE_LLM_TIMEOUT=45
DASHBOARD_PORT=8888

# How the APPS reach the gateway from outside this machine. Set to your
# Tailscale hostname (recommended) or LAN IP. Used to build snapshot/live-view
# URLs in push cards, so it must be reachable from your phone.
#   e.g. http://my-machine.tailXXXX.ts.net:8080  or  http://192.168.1.50:8080
GATEWAY_PUBLIC_URL=http://localhost:8080

# How CONTAINERS reach the gateway internally (leave as-is under compose).
GATEWAY_INTERNAL_URL=http://mobile_gateway:8080

# Inbound webhook ingress (POST /webhook/{source}). Set a secret to enable
# external services (IFTTT, GitHub, automations) to push onto the bus.
WEBHOOK_SECRET=

# --- APNs real iOS push (optional; needs a paid Apple Developer account) ---
# Create an APNs auth key (.p8) at developer.apple.com → Certificates → Keys,
# save it under data/apns/ (gitignored), then fill these in. All five must be
# set or push silently no-ops (WebSocket + local notifications still work).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENV=sandbox


# ==============================================================================
# 5. VOICE PIPELINE — wake word, STT, TTS
# ==============================================================================

# TTS engine for the containerized speaker: "piper" (fast, local) or "xtts".
TTS_ENGINE=piper
PIPER_MODEL=en_GB-alan-medium

# Voice used by the Mac TTS + the app's synthesized replies.
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=-5%
TTS_PITCH=-5Hz

# ElevenLabs (optional, best quality). Chain is ElevenLabs → edge-tts → piper.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Speech to text ---
# STT_DEVICE: auto (CUDA when available, else CPU), cuda, or cpu
STT_DEVICE=auto
# Empty = device default (turbo on GPU, small on CPU).
# Options: tiny, base, small, medium, turbo, large-v3
STT_MODEL=
AUDIO_DIR=/data/audio_cache
AUDIO_CACHE_MAX_FILES=200
# Mic tuning — raise SILENCE_THRESHOLD in a noisy room.
STT_SILENCE_THRESHOLD=500
STT_SILENCE_DURATION=1.0
STT_INITIAL_GRACE=2.0
# Seconds the mic stays open for a follow-up after Jarvis answers.
STT_FOLLOWUP_WINDOW=8

# --- Wake word ---
WAKE_THRESHOLD=0.5
WAKE_COOLDOWN=2
# Require two detections within this gap (cuts false wakes from TV audio).
WAKE_CONFIRM_GAP_S=0

# --- Speaker verification ---
VERIFY_THRESHOLD=0.25
# off (skip) | log (verify + log, never block — default) | enforce (reject)
VERIFY_MODE=log
MODEL_DIR=/models/speaker_model

# Playback volume for the native audio player (0.0–1.0).
PLAYER_VOLUME=0.7


# ==============================================================================
# 6. HOME, CAMERAS, VISION & PRESENCE
# ==============================================================================

# --- Home Assistant (unlocks lights, scenes, Apple TV, PetKit, HA MCP) ---
# Under compose HA runs as a service; from outside use its LAN IP.
HA_URL=http://homeassistant:8123
# Profile → Security → Long-Lived Access Token
HA_TOKEN=

# --- PetKit feeders/fountain (via the HACS PetKit integration in HA) ---
PETKIT_USERNAME=
PETKIT_PASSWORD=
PETKIT_REGION=

# --- Ring cameras (via the ring_mqtt bridge container) ---
# One-time login happens in the bridge's web UI at http://localhost:55123.
# Livestream credentials you set in the bridge config:
RING_LIVE_USER=
RING_LIVE_PASS=
RING_RTSP_BASE=rtsp://ring_mqtt:8554
RING_LIVE_DURATION_S=300
# Minimum seconds between vision assessments per camera.
SENTRY_COOLDOWN_S=600

# --- Face recognition (InsightFace sidecar) ---
FACE_SIMILARITY_THRESHOLD=0.45
# Legacy webcam mode only: {"name":"rtsp://..."}
CAMERAS={}

# --- Presence & arrival behavior (seconds) ---
# Ignore a re-arrival within this window (GPS flap guard).
ARRIVAL_DEBOUNCE_S=1800
# Hold the spoken welcome until camera motion confirms entry, or this timeout.
ARRIVAL_GREET_FALLBACK_S=150
# A "left" this soon after an "arrived" is treated as GPS jitter.
DEPARTURE_GRACE_S=120
# Local-hour window where first motion triggers the morning briefing.
WAKE_WINDOW=5-10
# Room the ambient/morning agents speak into by default.
AMBIENT_ROOM=office


# ==============================================================================
# 7. WEB, SEARCH & MCP INTEGRATIONS  (all optional)
# ==============================================================================

# --- Web search ---
# Native Anthropic web search is the DEFAULT for the research agents (Ada,
# Jeeves, Walter) as of 2026-08 — it needs no key beyond ANTHROPIC_API_KEY,
# and the model searches iteratively instead of taking one fixed result set.
# Billed separately from tokens (~$10 per 1,000 searches), so each call caps
# its own search count.
# Must be a search-capable model; dynamic filtering needs Opus 4.6+/Sonnet 4.6+.
SEARCH_LLM_MODEL=claude-sonnet-5
SEARCH_MAX_USES=5
RESEARCH_MAX_SEARCHES=8
# Walter (daily digest) stays on Tavily by default — native search measured
# ~$0.57/digest vs ~$0.01, and a news summary doesn't need iterative search.
NEWSLETTER_NATIVE_SEARCH=false

# Tavily — now the FALLBACK for those agents (used if native search fails or
# ANTHROPIC_API_KEY is unset). Still the only search path for ClassPass
# studio lookups. tavily.com
TAVILY_API_KEY=

# Firecrawl — JS/anti-bot page scraping + structured extraction. Preferred for
# ALL public reads (more reliable than local scraping). firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_URL=https://api.firecrawl.dev
FETCH_MAX_CHARS=20000

# Google Maps MCP — directions, distance matrix, geocoding, places.
# console.cloud.google.com → enable Maps Platform APIs → create key.
GOOGLE_MAPS_API_KEY=

# Video-native analysis (/ask/video). Two ways to reach Gemini — set either.
#
# 1. Vertex AI (preferred): set GOOGLE_CLOUD_PROJECT to a GCP project with
#    billing enabled and the Vertex AI API on. Usage is billed to that
#    project, so ordinary GCP credit (e.g. the $300 free trial) covers it.
#    On a GCP VM no key is needed — the VM's service account authenticates.
#    Off GCP, point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON
#    (roles/aiplatform.user), or run `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
#
# 2. Google AI Studio key (fallback): aistudio.google.com. DIFFERENT key from
#    Maps. NOTE: AI Studio bills a separate prepay balance that GCP credits do
#    NOT fund — if you see "prepayment credits are depleted", use Vertex above.
GOOGLE_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.6-flash

# Password for the dashboard. The dashboard shows conversation history, the
# approvals queue and camera snapshots, so leaving this empty means anyone who
# can reach the port can read all of it. Empty = no login (a warning is printed
# at startup). The setup wizard generates one for new installs.
DASHBOARD_PASSWORD=

# Optional: attribute amazon_add_to_cart links to an Associates tag.
# The tool works without it.
AMAZON_ASSOCIATE_TAG=

# Which HEB you shop. Prices, stock and cart are per-STORE and Austin has
# several, so a cart built against the wrong one looks normal and only fails at
# pickup. Set this and the grocery report flags a mismatch (e.g. "Mueller").
HEB_STORE=

# GitHub MCP + github_tool — a personal access token.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# 17TRACK package tracking MCP — 17track.net → Settings → API (free 100/mo).
API_TOKEN_17TRACK=

# Resy restaurant reservations MCP (your own account; personal use only).
RESY_EMAIL=
RESY_PASSWORD=

# Expedia travel MCP (optional; Kiwi/Jinko/Airbnb MCPs need no key).
EXPEDIA_API_KEY=

# NOTE: Uber Eats / DoorDash / Gmail / Google Calendar MCPs use browser OAuth,
# not env keys — run scripts/authorize_food_mcps.sh and
# scripts/authorize_google_mcps.sh once. Enable/disable every MCP server in
# config/mcp_servers.yml.


# ==============================================================================
# 8. COMMS — outbound email, SMS, inbox triage
# ==============================================================================

# --- SMTP (send_email). Works with Gmail app passwords, Fastmail, etc. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DEFAULT_TO=

# --- Twilio (send_sms + outbound calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_TO=

# --- IMAP (Hermes, the email triage agent) ---
# Gmail: use an App Password, NOT your login password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=


# ==============================================================================
# 9. FINANCE & MEDIA
# ==============================================================================

# BankSync MCP — balances + transactions for Brad (finance) and Spend Guardian.
BANKSYNC_API_KEY=
BANKSYNC_MCP_URL=https://mcp.banksync.io

# SoFi (optional direct integration)
SOFI_API_TOKEN=
SOFI_API_BASE=
SOFI_QUEUE_NAME=

# Spotify (playback control requires Premium).
# Create an app at developer.spotify.com/dashboard, then get a refresh token
# via the dashboard's /spotify-setup page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=


# ==============================================================================
# 10. FILES, SHELL & THE DEVELOPER AGENT
# ==============================================================================

JARVIS_WORKSPACE=/data/workspace
NOTES_DIR=/data/notes
FILE_MAX_READ_CHARS=40000

# run_shell allowlist: comma-separated command names, or "*" for any (trusted
# machines ONLY). Empty = built-in safe default set.
SHELL_ALLOWLIST=
SHELL_TIMEOUT=60
MAC_SHELL_ALLOWLIST=

# run_python executes code in a subprocess. Off by default.
# NOTE: changing this needs a container RECREATE, not just a restart.
CODE_EXEC_ENABLED=false
CODE_EXEC_TIMEOUT=30

# --- Mac bridge (native host API for mac_* tools, signed-in browsing, Forge) ---
# host.docker.internal works when containers run ON the Mac. For a VPS split,
# set this to the Mac's Tailscale hostname.
MAC_BRIDGE_HOST=host.docker.internal
MAC_BRIDGE_PORT=7777

# Forge prefers the Claude Code CLI on the host (billed to a Claude subscription
# rather than API credits); the API tool-loop is the fallback.
DEV_PREFER_CLI=true
DEV_CLI_BIN=/usr/local/bin/claude
DEV_CLI_TIMEOUT_S=900
DEV_AGENT_MAX_STEPS=40


# ==============================================================================
# 11. AGENT TUNING + VPS SPLIT  (sane defaults — change only if needed)
# ==============================================================================

# Synapse: event correlation + notification digest batching.
SYNAPSE_RULE_INTERVAL_S=300
SYNAPSE_RULE_COOLDOWN_S=43200
DIGEST_INTERVAL_S=3600
DIGEST_MAX=8
NOTIFY_DEDUP_TTL_S=1800

# Chronicle: how many missed days to back-fill in one nightly run.
CHRONICLE_CATCHUP_MAX=3

# Echo (habit miner): history window and max suggestions per night.
HABIT_WINDOW_DAYS=14
HABIT_MAX_SUGGESTIONS=2

# Approval Inbox: how long a pending approval lives (seconds).
APPROVAL_TTL_S=86400

# Vega (QA agent): per-case timeout against the live brain.
QA_CASE_TIMEOUT_S=60

# Miles (travel): alert threshold for a price drop, and brain query timeout.
TRAVEL_WATCH_DROP_PCT=5
TRAVEL_BRAIN_TIMEOUT_S=120

# --- Cloud/edge split (docker-compose.core.yml + docker-compose.edge.yml) ---
# On the VPS: the Mac's Tailscale hostname (for mac_bridge + HA).
MAC_HOST=
# On the Mac: the VPS's Tailscale hostname (edge services connect to it).
JARVIS_CORE_HOST=
