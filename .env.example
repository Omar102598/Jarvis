# ==============================================================================
# JARVIS Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=gpt-4.1

# --- Home Assistant ---
HA_URL=http://192.168.1.100:8123
HA_TOKEN=your-long-lived-access-token-here

# --- Govee (direct cloud API, optional if using HA integration) ---
GOVEE_API_KEY=your-govee-api-key-here

# --- Web Search ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Ring (optional, if using ring-client-api directly) ---
RING_REFRESH_TOKEN=your-ring-refresh-token-here

# --- Infrastructure ---
MQTT_HOST=mosquitto
REDIS_HOST=redis

# --- Audio Cache (shared between STT and Speaker Verify) ---
AUDIO_DIR=/data/audio_cache

# --- Room Configuration ---
ROOM_NAME=office

# --- Vision ---
# JSON map of camera_id to RTSP URL
CAMERA_URLS={}
# Example: CAMERA_URLS={"front_door": "rtsp://192.168.1.50:554/stream", "backyard": "rtsp://192.168.1.51:554/stream"}
PROCESS_FPS=5
FACE_THRESHOLD=0.4

# --- Speech-to-Text ---
# STT_DEVICE: auto (default — CUDA when available, else CPU), cuda, or cpu
STT_DEVICE=auto
# STT_MODEL: leave empty for the device default (turbo on GPU, small on CPU).
# Options: tiny, base, small, medium, turbo, large-v3
STT_MODEL=

# --- Speaker Verification ---
VERIFY_THRESHOLD=0.25
# VERIFY_MODE: off (skip), log (verify + log, never block — default),
#              enforce (reject unrecognized voices)
VERIFY_MODE=log

# --- Wake Word ---
WAKE_THRESHOLD=0.5

# --- Mobile Gateway (iPhone / Siri Shortcut) ---
# Port the gateway listens on (mapped from the Docker container)
MOBILE_GATEWAY_PORT=8080
# Secret key the Siri Shortcut sends in the X-API-Key header.
# Set to a long random string. Leave empty to disable auth (LAN-only setups).
MOBILE_API_KEY=change-me-to-a-long-random-secret
# How long (seconds) to wait for the LLM agent to respond
MOBILE_LLM_TIMEOUT=45


# Options: "piper" (fast, local) or "xtts" (quality, voice cloning)
TTS_ENGINE=piper
PIPER_MODEL=en_GB-alan-medium

# --- Phase 0: Background Agents + Dashboard ---
DASHBOARD_PORT=8888
