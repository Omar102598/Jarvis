# ---------------------------------------------------------------------------
# Dataclasses
# ---------------------------------------------------------------------------
@dataclass
class PriceResult:
    store: str
    store_name: str
    item: str
    price: Optional[float] = None
    unit: str = ""
    error: str = ""


@dataclass
class OrderResult:
    item: str
    assigned_store: str
    assigned_store_name: str
    best_price: Optional[float]
    status: str  # "added" | "not_found" | "error" | "budget_exceeded" | "skipped_store"
    note: str = ""
    all_prices: list[PriceResult] = field(default_factory=list)


# ---------------------------------------------------------------------------
# Logging helper
# ---------------------------------------------------------------------------
def _log(msg: str) -> None:
    print(f"[GroceryAgent] {msg}", flush=True)


# ---------------------------------------------------------------------------
# Mac Bridge helpers
# ---------------------------------------------------------------------------
async def _bridge(session: aiohttp.ClientSession, tool: str, params: dict) -> dict:
    try:
        async with session.post(
            f"{MAC_BRIDGE_URL}/run",
            json={"tool": tool, "params": params},
            timeout=aiohttp.ClientTimeout(total=90),
        ) as resp:
            return await resp.json()
    except asyncio.TimeoutError:
        return {"error": f"Timeout calling bridge tool '{tool}'"}
    except Exception as exc:
        return {"error": str(exc)}


async def _check_bridge(session: aiohttp.ClientSession) -> bool:
    try:
        async with session.get(
            f"{MAC_BRIDGE_URL}/health",
            timeout=aiohttp.ClientTimeout(total=5),
        ) as resp:
            data = await resp.json()
            return data.get("status") == "ok"
    except Exception as exc:
        _log(f"Bridge health check failed: {exc}")
        return False


# ---------------------------------------------------------------------------
# Price extraction helpers
# ---------------------------------------------------------------------------
def _extract_price(text: str) -> Optional[float]:
    """Extract the first dollar price from a string."""
    match = re.search(r"\$\s*(\d+\.?\d*)", str(text) or "")
    return float(match.group(1)) if match else None


def _extract_price_from_page_text(page_text: str, item: str) -> Optional[float]:
    """
    Fallback: scan raw page text for price patterns near the item name.
    Looks for $X.XX patterns in the first 3000 chars of page text.
    """
    prices = re.findall(r"\$\s*(\d{1,3}(?:\.\d{2})?)", page_text[:5000])
    valid = []
    for p in prices:
        val = float(p)
        # Sanity check: grocery items should be between $0.50 and $80
        if 0.50 <= val <= 80.0:
            valid.append(val)
    if valid:
        # Return the most common reasonable price (median-ish)
        valid.sort()
        return valid[len(valid) // 2]
    return None


# ---------------------------------------------------------------------------
# Per-store price scrapers (v3.2 — fixed selectors + fallback)
# ---------------------------------------------------------------------------

async def _scrape_amazon_price(
    session: aiohttp.ClientSession, item: str, store_key: str
) -> PriceResult:
    store = STORES[store_key]
    url = store["search_url"].format(query=item.replace(" ", "+"))
    result = PriceResult(store=store_key, store_name=store["name"], item=item)
    _log(f"  Scraping {store['name']} price for: {item}")

    nav = await _bridge(session, "mac_chrome_navigate", {"url": url})
    if "error" in nav:
        result.error = nav["error"]
        _log(f"  ✗ {store['name']} nav error: {nav['error']}")
        return result

    await asyncio.sleep(4)

    # Scroll to trigger lazy-load
    await _bridge(session, "mac_chrome_js", {"script": "window.scrollBy(0, 400);"})
    await asyncio.sleep(2)

    # Try multiple Amazon price selectors (Fresh + standard)
    price_js = """
    (function() {
        var selectors = [
            '.a-price .a-offscreen',
            '.a-price-whole',
            '[data-cy="price-recipe"] .a-offscreen',
            '.s-price-instructions-style .a-offscreen',
            '.a-color-price',
            '.a-price',
        ];
        for (var s of selectors) {
            var els = Array.from(document.querySelectorAll(s))
                .map(el => el.innerText || el.textContent)
                .filter(t => t && t.includes('$'));
            if (els.length > 0) return els[0].trim();
        }
        return null;
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": price_js})
    raw = res.get("result") or ""

    if raw:
        result.price = _extract_price(str(raw))
        result.unit = str(raw).strip()
    else:
        # Fallback: read page text and scan for prices
        page = await _bridge(session, "mac_chrome_read", {})
        text = page.get("result") or page.get("text") or ""
        result.price = _extract_price_from_page_text(str(text), item)
        if result.price:
            result.unit = f"~${result.price:.2f} (from page text)"

    _log(f"  ✓ {store['name']}: {result.unit or 'N/A'} (${result.price:.2f})" if result.price else f"  ✗ {store['name']}: N/A")
    return result


