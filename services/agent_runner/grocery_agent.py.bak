async def _compare_prices(
    session: aiohttp.ClientSession, item: str
) -> list[PriceResult]:
    results: list[PriceResult] = []
    results.append(await _scrape_amazon_price(session, item, "amazon"))
    await asyncio.sleep(1)
    results.append(await _scrape_amazon_price(session, item, "whole_foods"))
    await asyncio.sleep(1)
    results.append(await _scrape_target_price(session, item))
    await asyncio.sleep(1)
    results.append(await _scrape_heb_price(session, item))
    return results


def _best_price_result(prices: list[PriceResult]) -> PriceResult:
    valid = [p for p in prices if p.price is not None]
    if not valid:
        # Default to amazon if no prices found
        return next((p for p in prices if p.store == "amazon"), prices[0])
    return min(valid, key=lambda p: p.price)  # type: ignore[arg-type]


# ---------------------------------------------------------------------------
# Store selection: pick 1-2 stores that cover the most items cheapest
# ---------------------------------------------------------------------------
def _select_ordering_stores(
    price_map: dict[str, list[PriceResult]],
    budget: float,
) -> tuple[list[str], dict[str, str]]:
    item_best: dict[str, PriceResult] = {
        item: _best_price_result(prices)
        for item, prices in price_map.items()
    }

    store_wins: dict[str, int] = defaultdict(int)
    for best in item_best.values():
        store_wins[best.store] += 1

    # If no store won anything (all N/A), default to amazon
    if not store_wins:
        store_wins["amazon"] = len(price_map)

    ranked_stores = sorted(store_wins, key=lambda s: store_wins[s], reverse=True)
    selected_stores = ranked_stores[:2]

    item_to_store: dict[str, str] = {}
    for item, prices in price_map.items():
        candidates = [p for p in prices if p.store in selected_stores and p.price is not None]
        if candidates:
            item_to_store[item] = min(candidates, key=lambda p: p.price).store  # type: ignore
        else:
            # Default to first selected store
            item_to_store[item] = selected_stores[0]

    return selected_stores, item_to_store


# ---------------------------------------------------------------------------
# Per-store cart automation (v3.2 — fixed selectors)
# ---------------------------------------------------------------------------

async def _add_to_amazon_cart(
    session: aiohttp.ClientSession, item: str, store_key: str
) -> tuple[str, str]:
    store_name = STORES[store_key]["name"]
    search_url = STORES[store_key]["search_url"].format(query=item.replace(" ", "+"))
    _log(f"  Adding to {store_name} cart: {item}")

    # Navigate directly to search results
    nav = await _bridge(session, "mac_chrome_navigate", {"url": search_url})
    if "error" in nav:
        return "error", f"Navigation failed: {nav['error']}"
    await asyncio.sleep(4)

    # Click first product result
    click_product_js = """
    (function() {
        var links = Array.from(document.querySelectorAll(
            'h2 a.a-link-normal, .s-product-image-container a, [data-cy="title-recipe"] a'
        )).filter(a => a.href && a.href.includes('/dp/'));
        if (!links.length) return 'no_products_found';
        links[0].click();
        return 'clicked_product';
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": click_product_js})
    val = str(res.get("result") or "").lower()
    if "no_products" in val:
        return "not_found", "No product results found on Amazon."
    await asyncio.sleep(4)

    # Click Add to Cart
    add_js = """
    (function() {
        var selectors = [
            '#add-to-cart-button',
            'input[name="submit.add-to-cart"]',
            'button[name="submit.add-to-cart"]',
        ];
        for (var s of selectors) {
            var btn = document.querySelector(s);
            if (btn) { btn.click(); return 'clicked_add_to_cart:' + s; }
        }
        // Fallback: text match
        var btns = Array.from(document.querySelectorAll('button, input[type="submit"]'))
            .filter(el => /add to cart/i.test(el.innerText || el.value || ''));
        if (btns.length) { btns[0].click(); return 'clicked_add_to_cart:text_match'; }
        return 'no_add_button_found';
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": add_js})
    val = str(res.get("result") or "").lower()

    if "clicked" in val:
        _log(f"  ✓ Added to {store_name} cart: {item}")
        return "added", f"Added to {store_name} cart."
    _log(f"  ✗ No Add to Cart button for: {item} ({val})")
    return "not_found", f"No 'Add to Cart' button found ({val})."


async def _add_to_target_cart(
    session: aiohttp.ClientSession, item: str
) -> tuple[str, str]:
    url = STORES["target"]["search_url"].format(query=item.replace(" ", "+"))
    _log(f"  Adding to Target cart: {item}")

    nav = await _bridge(session, "mac_chrome_navigate", {"url": url})
    if "error" in nav:
        return "error", f"Navigation failed: {nav['error']}"
    await asyncio.sleep(5)

    # Click first product
    click_js = """
    (function() {
        var links = Array.from(document.querySelectorAll(
            'a[data-test="product-title"], [data-test="product-details"] a, a[href*="/p/"]'
        )).filter(a => a.href);
        if (!links.length) return 'no_products';
        links[0].click();
        return 'clicked_product';
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": click_js})
    val = str(res.get("result") or "").lower()
    if "no_products" in val:
        return "not_found", "No product results found on Target."
    await asyncio.sleep(4)

    # Add to cart
    add_js = """
    (function() {
        var selectors = [
            '[data-test="shippingButton"]',
            '[data-test="orderPickupButton"]',
            '[data-test="addToCartButton"]',
            'button[id*="addToCart"]',
        ];
        for (var s of selectors) {
            var btn = document.querySelector(s);
            if (btn) { btn.click(); return 'clicked:' + s; }
        }
        var btns = Array.from(document.querySelectorAll('button'))
            .filter(b => /add to cart/i.test(b.innerText));
        if (btns.length) { btns[0].click(); return 'clicked:text_match'; }
        return 'no_add_button';
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": add_js})
    val = str(res.get("result") or "").lower()

    if "clicked" in val:
        _log(f"  ✓ Added to Target cart: {item}")
        return "added", "Added to Target cart."
    _log(f"  ✗ Target cart failed for: {item} ({val})")
    return "not_found", f"Could not add to Target cart: {val}"


async def _add_to_heb_cart(
    session: aiohttp.ClientSession, item: str
) -> tuple[str, str]:
    url = STORES["heb"]["search_url"].format(query=item.replace(" ", "+"))
    _log(f"  Adding to HEB cart: {item}")

    nav = await _bridge(session, "mac_chrome_navigate", {"url": url})
    if "error" in nav:
        return "error", f"Navigation failed: {nav['error']}"
    await asyncio.sleep(5)

    add_js = """
    (function() {
        var btns = Array.from(document.querySelectorAll('button'))
            .filter(b => /add to cart|add item/i.test(b.innerText || b.getAttribute('aria-label') || ''));
        if (!btns.length) return 'no_add_button';
        btns[0].click();
        return 'clicked_add_to_cart';
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": add_js})
    val = str(res.get("result") or "").lower()

    if "clicked" in val:
        _log(f"  ✓ Added to HEB cart: {item}")
        return "added", "Added to HEB cart."
    _log(f"  ✗ HEB cart failed for: {item} ({val})")
    return "not_found", f"Could not add to HEB cart: {val}"


async def _add_to_store_cart(
    session: aiohttp.ClientSession, item: str, store_key: str
) -> tuple[str, str]:
    if store_key in ("amazon", "whole_foods"):
        return await _add_to_amazon_cart(session, item, store_key)
    elif store_key == "target":
        return await _add_to_target_cart(session, item)
    elif store_key == "heb":
        return await _add_to_heb_cart(session, item)
    return "error", f"No cart handler for store: {store_key}"


# ---------------------------------------------------------------------------
# Amazon order history
# ---------------------------------------------------------------------------
async def _fetch_amazon_order_history(session: aiohttp.ClientSession) -> list[str]:
    _log("Step 1: Fetching Amazon order history…")
    nav = await _bridge(
        session,
        "mac_chrome_navigate",
        {"url": "https://www.amazon.com/gp/your-account/order-history"},
    )
    if "error" in nav:
        _log(f"  ✗ Order history nav failed: {nav['error']}")
        return []
    await asyncio.sleep(5)

    history_js = """
    (function() {
        var items = Array.from(document.querySelectorAll(
            '.yohtmlc-product-title, .a-link-normal[href*="/dp/"], .product-title'
        )).map(el => el.innerText.trim()).filter(t => t.length > 3 && t.length < 80);
        return [...new Set(items)].slice(0, 30);
    })();
    """
    res = await _bridge(session, "mac_chrome_js", {"script": history_js})
    raw = res.get("result", [])
    items = [str(r) for r in raw if r] if isinstance(raw, list) else []

    # Fallback: read page text
    if not items:
        page = await _bridge(session, "mac_chrome_read", {})
        text = str(page.get("result") or page.get("text") or "")
        # Extract lines that look like product names
        lines = [l.strip() for l in text.split("\n") if 5 < len(l.strip()) < 80]
        items = lines[:20]

    _log(f"  ✓ Found {len(items)} past purchases.")
    return items


# ---------------------------------------------------------------------------
# LLM grocery list generation
# ---------------------------------------------------------------------------
async def _generate_smart_list(past_purchases: list[str]) -> list[str]:
    _log("Step 2: Generating smart grocery list via LLM…")
    staples_json = json.dumps(HIGH_PROTEIN_STAPLES, indent=2)
    past_json = json.dumps(past_purchases[:20], indent=2)

    user_msg = (
        f"High-protein staples reference:\n{staples_json}\n\n"
        f"User's recent Amazon purchases:\n{past_json}\n\n"
        "Generate the weekly grocery list now."
    )

    response = await complete(system=_LIST_SYSTEM, user=user_msg, max_tokens=400)

    try:
        match = re.search(r"\[.*\]", response or "", re.DOTALL)
        if match:
            items = json.loads(match.group())
            if isinstance(items, list):
                _log(f"  ✓ Generated list of {len(items)} items.")
                return [str(i) for i in items]
    except (json.JSONDecodeError, AttributeError):
        pass

    _log("  ⚠ LLM list parse failed — falling back to staples.")
    return [s["item"] for s in HIGH_PROTEIN_STAPLES[:14]]


# ---------------------------------------------------------------------------
# Main Agent
# ---------------------------------------------------------------------------
class GroceryAgent(BaseAgent):
    """
    Smart grocery agent — v3.2

    Workflow:
      0. Health-check Mac Bridge.
      1. Pull Amazon order history for personalisation.
      2. LLM generates a high-protein, cutting-phase grocery list.
      3. Price-compare every item across Target, HEB, Amazon Grocery, Whole Foods.
         Uses improved CSS selectors + page-text fallback.
      4. Select the 1-2 stores that cover the most items at the lowest total cost.
      5. Add items to each selected store's cart (no checkout).
      6. Send a detailed summary notification.
    """

    async def run(self) -> str:
        budget: float = self.params.get(
            "weekly_budget_usd", USER_PROFILE["weekly_budget_usd"]
        )
        _log(f"=== Grocery Agent v3.2 starting. Budget: ${budget:.0f} ===")
        _log(f"Mac Bridge URL: {MAC_BRIDGE_URL}")

        order_results: list[OrderResult] = []
        total_spend = 0.0

        async with aiohttp.ClientSession() as session:

            # ── 0. Health check ────────────────────────────────────────────
            _log("Step 0: Checking Mac Bridge connectivity…")
            bridge_ok = await _check_bridge(session)
            if not bridge_ok:
                err = f"Mac Bridge unreachable at {MAC_BRIDGE_URL}. Cannot proceed."
                _log(f"  ✗ {err}")
                return err
            _log("  ✓ Mac Bridge is reachable.")

            # ── 1. Amazon order history ────────────────────────────────────
            past_purchases = await _fetch_amazon_order_history(session)

            # ── 2. Generate smart grocery list ────────────────────────────
            grocery_list = await _generate_smart_list(past_purchases)

            # ── 3. Price compare all items ────────────────────────────────
            _log(f"Step 3: Comparing prices for {len(grocery_list)} items across 4 stores…")
            price_map: dict[str, list[PriceResult]] = {}
            for i, item in enumerate(grocery_list, 1):
                _log(f"  [{i}/{len(grocery_list)}] {item}")
                price_map[item] = await _compare_prices(session, item)
                await asyncio.sleep(1)

            # Summary of price coverage
            priced = sum(
                1 for prices in price_map.values()
                if any(p.price is not None for p in prices)
            )
            _log(f"  ✓ Price comparison complete. {priced}/{len(grocery_list)} items priced.")

            # ── 4. Select 1-2 best stores ─────────────────────────────────
            _log("Step 4: Selecting best 1-2 stores…")
            selected_stores, item_to_store = _select_ordering_stores(price_map, budget)
            selected_names = [STORES[s]["name"] for s in selected_stores]
            _log(f"  ✓ Selected stores: {', '.join(selected_names)}")

            # ── 5. Add items to carts, respecting budget ───────────────────
            _log("Step 5: Adding items to carts (no checkout)…")
            for item in grocery_list:
                assigned_store = item_to_store.get(item, selected_stores[0])
                assigned_name = STORES[assigned_store]["name"]
                prices = price_map[item]
                best_pr = _best_price_result(prices)

                if total_spend >= budget:
                    _log(f"  ⚠ Budget cap reached — skipping: {item}")
                    order_results.append(OrderResult(
                        item=item,
                        assigned_store=assigned_store,
                        assigned_store_name=assigned_name,
                        best_price=best_pr.price,
                        status="budget_exceeded",
                        note=f"Skipped — ${budget:.0f} budget reached.",
                        all_prices=prices,
                    ))
                    continue

                if assigned_store not in selected_stores:
                    order_results.append(OrderResult(
                        item=item,
                        assigned_store=assigned_store,
                        assigned_store_name=assigned_name,
                        best_price=best_pr.price,
                        status="skipped_store",
                        note=f"{assigned_name} not in selected ordering stores.",
                        all_prices=prices,
                    ))
                    continue

                status, note = await _add_to_store_cart(session, item, assigned_store)

                if best_pr.price is not None and status == "added":
                    total_spend += best_pr.price

                order_results.append(OrderResult(
                    item=item,
                    assigned_store=assigned_store,
                    assigned_store_name=assigned_name,
                    best_price=best_pr.price,
                    status=status,
                    note=note,
                    all_prices=prices,
                ))

                await asyncio.sleep(1)

        # ── 6. Build summary ───────────────────────────────────────────────
        _log("Step 6: Building summary…")
        added   = [r for r in order_results if r.status == "added"]
        failed  = [r for r in order_results if r.status in ("not_found", "error", "uncertain")]
        skipped = [r for r in order_results if r.status == "budget_exceeded"]

        store_subtotals: dict[str, float] = defaultdict(float)
        store_item_counts: dict[str, int] = defaultdict(int)
        for r in added:
            if r.best_price:
                store_subtotals[r.assigned_store_name] += r.best_price
                store_item_counts[r.assigned_store_name] += 1

        total_savings = 0.0
        for r in order_results:
            valid_prices = [p.price for p in r.all_prices if p.price is not None]
            if len(valid_prices) >= 2 and r.best_price is not None:
                total_savings += max(valid_prices) - r.best_price

        price_table = []
        for r in order_results:
            row = {
                "item": r.item,
                "assigned_store": r.assigned_store_name,
                "best_price": f"${r.best_price:.2f}" if r.best_price else "N/A",
                "status": r.status,
                "all_prices": {
                    p.store_name: (f"${p.price:.2f}" if p.price else "N/A")
                    for p in r.all_prices
                },
            }
            price_table.append(row)

        summary_data = {
            "grocery_list": grocery_list,
            "selected_ordering_stores": selected_names,
            "items_added": len(added),
            "items_failed": len(failed),
            "items_skipped_budget": len(skipped),
            "estimated_total_usd": round(total_spend, 2),
            "budget_usd": budget,
            "budget_remaining_usd": round(budget - total_spend, 2),
            "total_savings_vs_most_expensive": round(total_savings, 2),
            "per_store_subtotals": dict(store_subtotals),
            "per_store_item_counts": dict(store_item_counts),
            "price_comparison_table": price_table,
            "failed_items": [{"item": r.item, "note": r.note} for r in failed],
        }

        _log(f"  ✓ {len(added)} added, {len(failed)} failed, {len(skipped)} skipped (budget).")
        _log(f"  ✓ Estimated spend: ${total_spend:.2f} / ${budget:.0f}")

        polished = await complete(
            system=_SUMMARY_SYSTEM,
            user=json.dumps(summary_data, indent=2),
            max_tokens=400,
        )

        _log("=== Grocery Agent v3.2 complete. ===")
        return polished or json.dumps(summary_data, indent=2)
