"""Finance plugin — SoFi transaction sync via Bank Sync MCP / API queue.

Credentials are read from environment variables at runtime so they can be
provided later without changing code:
  SOFI_API_BASE      e.g. https://banksync.example.com/api
  SOFI_API_TOKEN     bearer token
  SOFI_QUEUE_NAME    optional queue/topic name for the sync job
"""
import os
import json
import urllib.request
import urllib.error
from datetime import datetime, timedelta

# In-memory cache populated by the most recent sync.
_CACHE = {"transactions": [], "synced_at": None}


def _api_get(path: str):
    base = os.environ.get("SOFI_API_BASE", "").rstrip("/")
    token = os.environ.get("SOFI_API_TOKEN", "")
    if not base or not token:
        return {"error": "SoFi API not configured. Set SOFI_API_BASE and SOFI_API_TOKEN."}
    url = f"{base}/{path.lstrip('/')}"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}: {e.reason}"}
    except Exception as e:
        return {"error": str(e)}


def sofi_sync(days: int = 30) -> str:
    """Pull recent SoFi transactions into the local cache.

    Args:
        days: How many days back to fetch (default 30).
    """
    queue = os.environ.get("SOFI_QUEUE_NAME", "")
    path = f"transactions?days={days}"
    if queue:
        path += f"&queue={queue}"
    data = _api_get(path)
    if isinstance(data, dict) and data.get("error"):
        return f"Sync failed: {data['error']}"
    txns = data.get("transactions", data) if isinstance(data, dict) else data
    _CACHE["transactions"] = txns or []
    _CACHE["synced_at"] = datetime.utcnow().isoformat()
    return f"Synced {len(_CACHE['transactions'])} transactions from the last {days} days."


def sofi_balance() -> str:
    """Get current SoFi account balances."""
    data = _api_get("accounts")
    if isinstance(data, dict) and data.get("error"):
        return f"Balance fetch failed: {data['error']}"
    accts = data.get("accounts", data) if isinstance(data, dict) else data
    if not accts:
        return "No accounts returned."
    lines = []
    for a in accts:
        name = a.get("name", a.get("type", "account"))
        bal = a.get("balance", a.get("available", "?"))
        lines.append(f"{name}: ${bal}")
    return "; ".join(lines)


def sofi_spending(days: int = 30) -> str:
    """Summarise spending by category over the given period.

    Args:
        days: Lookback window in days (default 30).
    """
    if not _CACHE["transactions"]:
        msg = sofi_sync(days)
        if msg.startswith("Sync failed"):
            return msg
    by_cat = {}
    total = 0.0
    for t in _CACHE["transactions"]:
        amt = float(t.get("amount", 0) or 0)
        if amt < 0:  # spending
            cat = t.get("category", "Uncategorized")
            by_cat[cat] = by_cat.get(cat, 0.0) + abs(amt)
            total += abs(amt)
    if not by_cat:
        return "No spending transactions found. Run sofi_sync first or check the API."
    ranked = sorted(by_cat.items(), key=lambda x: -x[1])
    lines = [f"{c}: ${v:,.2f}" for c, v in ranked]
    return f"Total spending ${total:,.2f} over {days} days. " + "; ".join(lines)


# Tools exposed by this plugin.
TOOLS = [sofi_sync, sofi_balance, sofi_spending]