<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App metadata -->
    <key>CFBundleName</key>
    <string>Jarvis</string>
    <key>CFBundleDisplayName</key>
    <string>Jarvis</string>
    <key>CFBundleIdentifier</key>
    <string>com.jarvis.app</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Meta DAT SDK: MFi / ExternalAccessory protocol string -->
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.meta.frames</string>
    </array>

    <!-- Privacy usage descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Jarvis uses the microphone to accept your voice commands.</string>
    <key>NSCameraUsageDescription</key>
    <string>Jarvis uses the glasses camera to answer visual questions.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Jarvis uses on-device speech recognition for wake-word detection.</string>

    <!-- URL scheme for Meta AI OAuth callback -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>jarvisapp</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.jarvis.app</string>
        </dict>
    </array>

    <!-- Background audio for foreground wake-word detection -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
